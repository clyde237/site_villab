# Injectées par erp_pms au provisioning du container "web" de cet
# établissement (voir PLAN_CMS_SITE_VITRINE.md côté pms). En dev local,
# pointer vers une instance pms / meka_template déjà lancée.

# Slug de l'établissement (pour l'appel au contenu CMS public de pms)
TENANT_SLUG=weloobe

# URL de pms (contenu marketing : hero, à propos, contact, galerie, SEO)
CMS_API_URL=http://localhost:8080

# URL de l'instance meka_template de cet établissement (chambres, menu resto)
TENANT_API_URL=http://localhost:8092
